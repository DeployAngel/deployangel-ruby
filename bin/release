#!/usr/bin/env bash
# Prepares a release of the gem: bin/release 0.1.28 [--push]
#
# Checks the version is newer than the one on RubyGems, sets it in
# lib/deployangel/version.rb, dates CHANGELOG.md's "## Unreleased" section,
# runs the tests, commits "Release 0.1.28", and tags v0.1.28. With --push it
# pushes main and the tag, which starts .github/workflows/release.yml: the
# gem is published once a maintainer approves the rubygems environment.
set -euo pipefail
cd "$(dirname "$0")/.."

die() { echo "bin/release: $*" >&2; exit 1; }

version="${1:-}"
push="${2:-}"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Usage: bin/release X.Y.Z [--push]" >&2; exit 64; }
[[ -z "$push" || "$push" == "--push" ]] || { echo "Usage: bin/release X.Y.Z [--push]" >&2; exit 64; }

[[ "$(git branch --show-current)" == "main" ]] || die "release from main."
[[ -z "$(git status --porcelain)" ]] || die "commit your changes first."
git fetch -q origin main --tags
git merge-base --is-ancestor origin/main HEAD || die "main is behind origin/main. Pull first."
! git rev-parse -q --verify "refs/tags/v$version" > /dev/null || die "tag v$version already exists."
grep -q '^## Unreleased$' CHANGELOG.md || die 'CHANGELOG.md has no "## Unreleased" section to release.'

published=$(curl -fsS https://rubygems.org/api/v1/versions/deployangel/latest.json | ruby -rjson -e 'puts JSON.parse($stdin.read)["version"]')
ruby -e 'exit(Gem::Version.new(ARGV[0]) > Gem::Version.new(ARGV[1]))' "$version" "$published" ||
  die "$version isn't newer than $published, the latest on RubyGems."

sed -i.bak "s/^  VERSION = \".*\"$/  VERSION = \"$version\"/" lib/deployangel/version.rb && rm lib/deployangel/version.rb.bak
sed -i.bak "s/^## Unreleased$/## $version ($(date +%Y-%m-%d))/" CHANGELOG.md && rm CHANGELOG.md.bak
grep -q "VERSION = \"$version\"" lib/deployangel/version.rb || die "couldn't set the version in lib/deployangel/version.rb."

if ! bundle exec rspec; then
  git checkout -- lib/deployangel/version.rb CHANGELOG.md
  die "tests failed; nothing was committed."
fi

git commit -q -am "Release $version"
git tag "v$version"
echo "Committed and tagged v$version."

if [[ "$push" == "--push" ]]; then
  git push -q origin main "v$version"
  echo "Pushed. Approve the rubygems environment in the Release workflow to publish:"
  echo "  https://github.com/DeployAngel/deployangel-ruby/actions/workflows/release.yml"
else
  echo "To publish: git push origin main v$version, then approve the rubygems environment."
fi
